<Window x:Class="RazrabotkaNaPraktike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RazrabotkaNaPraktike"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Построение графика:" Height="738" Width="1343" Background="#FF279EBD" Icon="/7495243.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="688*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="610*"/>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="701*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <Menu Margin="0,0,14,650" Grid.RowSpan="2" Background="#FF279EBD" FontSize="16" FontWeight="Bold" Grid.Column="1" >
            <MenuItem Header="Меню" Width="610" Height="29"  >
                <MenuItem Header="О программе" ToolTip="Вывод информации о создателе и задании" Click="Info_Click"/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
        <GroupBox x:Name="GB2" Header="Таблица"  FontWeight="Bold"  HorizontalAlignment="Center" FontSize="16"
                  Margin="0,24,0,2" Width="601" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="43*"/>
                    <RowDefinition Height="124*"/>
                    <RowDefinition Height="63*"/>
                    <RowDefinition Height="59*"/>
                    <RowDefinition Height="52*"/>
                    <RowDefinition Height="60*"/>
                    <RowDefinition Height="56*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="134*"/>
                    <RowDefinition Height="51*"/>
                </Grid.RowDefinitions>
                <Label Content="Последовательность чисел:" VerticalAlignment="Center" Margin="22,0,22,0" 
                       Height="38" Grid.Row="1"/>
                <DataGrid x:Name="NumbersDataGrid" Margin="22,66,22,8" IsReadOnly="False"
                          CellEditEnding="NumbersDataGrid_CellEditEnding" Grid.Row="2" 
                          CanUserAddRows="False" Grid.RowSpan="2"  />
                <Label Content="Количество колонок:" VerticalAlignment="Top" Margin="22,40,383,0"
                       Height="29" Grid.Row="1" Grid.RowSpan="2"/>
                <TextBox x:Name="Ctolb" MaxLength="2" Margin="206,2,302,75" Grid.Row="2"/>
                <Button x:Name="FillButton" Content="Создать" Margin="307,2,163,63"  Click="FillButton_Click"
                        FontSize="14" Grid.Row="2"/>
                <Button x:Name="ClearButton" Content="Очистить" Margin="447,2,37,63" Click="ClearButton_Click"
                        FontSize="14" Grid.Row="2"/>
                <Button x:Name="SolveButton" Content="Выяснить" Margin="10,59,10,0" Click="SolveButton_Click"
                        FontSize="14" Grid.RowSpan="2" Grid.Row="4"/>
                <Label Content="Ответ является/не является:" VerticalAlignment="Center" Margin="10,0,10,0"
                       Height="55" Grid.Row="7"/>
                <TextBox x:Name ="Rezult" MaxLength="2" TextWrapping="Wrap" Text="" VerticalAlignment="Top"
                         IsReadOnly="True" Margin="10,0,10,0" Height="136" Grid.Row="9" Grid.RowSpan="2"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="График последовательности" FontWeight="Bold" FontSize="16"
                  HorizontalAlignment="Right" Margin="0,24,2,2" Width="688" Grid.Column="3" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="334*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="641*"/>
                    <RowDefinition Height="11*"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="ChartCanvas" Background="White" ClipToBounds="True"
                    Margin="0,2,0,10" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
